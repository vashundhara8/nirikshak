# ========================================
# MoTA Scholarship Platform Configuration
# ========================================

APP_ENV=development # production, development, testing

# -----------------
# Security
# -----------------
SECRET_KEY=generate-a-secure-random-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------
# Database (PostgreSQL)
# -----------------
DB_USER=mota
DB_PASSWORD=password
DB_NAME=mota_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -----------------
# Redis
# -----------------
REDIS_URL=redis://localhost:6379/0

# -----------------
# Object Storage (MinIO/S3)
# -----------------
MINIO_ROOT_USER=mota_admin
MINIO_ROOT_PASSWORD=mota_secret
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mota_admin
S3_SECRET_KEY=mota_secret
S3_BUCKET_NAME=mota-documents
S3_USE_SSL=false

# -----------------
# MFA / OTP
# -----------------
OTP_PROVIDER=development # production or development
# SMS_GATEWAY_URL=...
# SMS_GATEWAY_KEY=...

# -----------------
# Real OGD API
# -----------------
# PRESERVE YOUR LOCAL KEY (Never commit real keys!)
DATA_GOV_API_KEY=your_real_key_here
ALLOW_MOCK_PROVIDERS=true # MUST BE false in production
